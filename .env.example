# Variables de entorno de la plataforma. SOLO NOMBRES: no escribas valores reales aquí.
# Copia a .env.local (ignorado por git) para desarrollo local. Detalle en docs/ENVIRONMENT.md.

# ── CORE-9.0 (activas) ───────────────────────────────────────────────────────
# mock = usuarios ficticios locales. SOLO desarrollo/demo (next dev): en producción
# está prohibido y el servidor no arranca con AUTH_MODE=mock.
# supabase = reservado para CORE-9.1; hoy no inicia sesión.
AUTH_MODE=

# ── CORE-9.1 (futuras, NO usadas todavía) ────────────────────────────────────
# El propietario las configurará desde su cuenta de Supabase. Públicas por diseño
# (URL del proyecto y clave anónima/publicable), pero no se commitean valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La service-role key NUNCA va al navegador, a este archivo ni al repositorio: solo al
# gestor de secretos del servidor, y únicamente si una etapa futura la necesita.

# Variables de entorno de la plataforma. SOLO NOMBRES: no escribas valores reales aquí.
# Copia a .env.local (ignorado por git) para desarrollo local. Detalle en docs/ENVIRONMENT.md.

# ── Supabase Auth y base de datos (CORE-9.1) ─────────────────────────────────
# Desarrollo local: los valores del stack local salen de `npx supabase@2.118.0 status -o env`
# (API_URL y PUBLISHABLE_KEY). Proyecto alojado: solo cuando el propietario lo autorice.
# Ambas son públicas por diseño (la protección real es RLS), pero no se commitean valores.
NEXT_PUBLIC_SUPABASE_URL=
# Solo la clave PUBLICABLE (sb_publishable_…). El servidor y el build se niegan a arrancar
# si aquí hay una clave secreta (sb_secret_…) o service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La clave secreta / service_role NUNCA va al navegador, a una variable NEXT_PUBLIC_*, a este
# archivo ni al repositorio. La aplicación no la usa. Las pruebas de integración locales la
# leen del stack local en tiempo de ejecución (scripts/supabase-test-env.mjs), sin guardarla.

# ── Provenance y auditoría firmadas (CORE-9.2, docs/adr/0004) ────────────────
# SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_. Entradas keyId:base64 (>= 32 bytes) separadas
# por comas; el propietario las genera y las guarda en el gestor de secretos del hosting.
PROVENANCE_SIGNING_KEYS=
PROVENANCE_ACTIVE_KEY_ID=

# ── OpenSEO: auditoría técnica manual (docs/adr/0006) ───────────────────────
# SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_: el servidor rechaza la configuración si alguna
# variable NEXT_PUBLIC_* contiene datos de OpenSEO. Los valores los pone el propietario en el
# gestor de secretos del hosting; nunca en este archivo, la BD, el Project State, logs ni Git.
# URL https base de la instancia (MCP en /mcp, salud en /api/health).
OPENSEO_ENDPOINT=
# Clave de API de OpenSEO (oseo_…). Secreta.
OPENSEO_API_KEY=
# Proyecto de OpenSEO donde se crean las auditorías.
OPENSEO_PROJECT_ID=
# Hosts auditables separados por comas (dominios públicos de clientes autorizados). Se rechazan
# IP, localhost y previews (*.vercel.app y similares). Vacía: no se puede lanzar ninguna auditoría.
OPENSEO_AUDIT_ALLOWED_HOSTS=
# Máximo de páginas por auditoría en este servidor: entero entre 10 y 500 (50 si se deja vacía).
OPENSEO_AUDIT_MAX_PAGES=
# Campo de primer nivel de whoami que confirma la autenticación (se elige tras la primera prueba).
OPENSEO_WHOAMI_IDENTITY_FIELD=
# Valores de get_audit_status (no documentados por OpenSEO), separados por comas. Se fijan tras
# observar una auditoría real; un estado no clasificado nunca se da por terminado.
OPENSEO_AUDIT_STATUS_COMPLETED=
OPENSEO_AUDIT_STATUS_FAILED=
OPENSEO_AUDIT_STATUS_PENDING=

# ── Retirada ─────────────────────────────────────────────────────────────────
# AUTH_MODE: la demostración de CORE-9.0 ya no existe. AUTH_MODE=mock sigue prohibido:
# build, start y el servidor de producción se niegan a arrancar con él. No la definas.
# Activate only after hosted migrations, signing keyring and isolation verification.
OPENSEO_PROJECT_JOBS_ENABLED=
